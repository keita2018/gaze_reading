# ============================================================
# gaze_reading_goal
#
# 原則としてGit管理するもの:
#   - src/
#   - scripts/
#   - configs/
#   - docs/（公開可能な文書のみ）
#   - notebooks/（必要なもののみ）
#   - README.md / PROJECT_STRUCTURE.md
#   - environment.yml / requirements*.txt
#   - 実行用PowerShellスクリプト
#
# 原則としてGit管理しないもの:
#   - 仮想環境
#   - raw / interim / processed data
#   - 外部リポジトリ
#   - 実験ログ
#   - outputs
#   - 学習済みモデル
#   - sealed labels / trial-level predictions
#   - 匿名査読用PDF・Word・提出パッケージ
#   - ローカル絶対パスや秘密情報を含むファイル
# ============================================================


# ------------------------------------------------------------
# Python bytecode / caches / test artifacts
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.pyright/
.hypothesis/
.tox/
.nox/

.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging / build
build/
dist/
site/
*.egg-info/
.eggs/
pip-wheel-metadata/


# ------------------------------------------------------------
# Virtual environments / local Python management
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.conda/
conda-bld/

# 外部ベンチマーク内の専用環境も除外
**/.venv/
**/venv/
**/.conda/


# ------------------------------------------------------------
# Environment variables / credentials / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

*.key
*.pem
*.p12
*.pfx
*.crt

credentials.json
credential.json
secrets.json
secret.json
tokens.json
token.json
service-account*.json
client_secret*.json

# CLI / cloud credentials
.osfcli.config
.aws/
.azure/
.gcloud/


# ------------------------------------------------------------
# IDE / editor / local history
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace

*.swp
*.swo
*~
.history/
.localhistory/


# ------------------------------------------------------------
# OS-generated files
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*:Zone.Identifier


# ------------------------------------------------------------
# Jupyter
# ------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb


# ------------------------------------------------------------
# Project data
#
# data/ 配下は raw / interim / processed を含むため全除外。
# ディレクトリ構造と説明ファイルだけ残せる。
# ------------------------------------------------------------
data/**

!data/
!data/**/
!data/**/.gitkeep
!data/**/README.md


# ------------------------------------------------------------
# External repositories / third-party assets
#
# OneStop, WebQAmGaze, zuco-benchmarkなどを本体へ直接含めない。
# 将来必要になればGit submoduleとして別管理する。
# ------------------------------------------------------------
external/**

!external/
!external/.gitkeep
!external/README.md


# ------------------------------------------------------------
# Logs / command transcripts
# ------------------------------------------------------------
logs/**
*.log
*.out
*.err
*.trace
*.clixml
transcript*.txt
powershell_transcript*.txt

!logs/
!logs/.gitkeep
!logs/README.md


# ------------------------------------------------------------
# Generated outputs
#
# 評価結果、予測、モデル、図表、監査、確認評価、P1/P2成果物を
# 含むため、outputs/以下は原則すべてGit管理しない。
# ------------------------------------------------------------
outputs/**

!outputs/
!outputs/.gitkeep
!outputs/README.md


# ------------------------------------------------------------
# Confirmatory-analysis safety
#
# outputs/全体を除外していても、将来の配置変更やallowlist追加時に
# sealed labels・結合済み予測を誤って追跡しないための明示的規則。
# ------------------------------------------------------------
**/sealed/**
**/*labels_sealed*
**/*sealed_labels*
**/*confirmatory_joined_trial_predictions*
**/*joined_trial_predictions*
**/*trial_level_predictions*
**/*participant_level_predictions*
**/*unblinded*
**/*unsealed*


# ------------------------------------------------------------
# Submission / manuscript / review packages
#
# 匿名査読版、Word/PDF、PCS入力資料、倫理レビュアーノート、
# confidential情報を含む可能性があるためローカル管理とする。
# ------------------------------------------------------------
submission/**
manuscript/**
drafts/**
review_package/**
camera_ready/**

!submission/
!submission/.gitkeep
!submission/README.md

!manuscript/
!manuscript/.gitkeep
!manuscript/README.md

# ルート直下へ一時保存されたOffice/PDF成果物
/*.doc
/*.docx
/*.pdf
/*.ppt
/*.pptx
/*.xls
/*.xlsx

# confidential / institution-specific notes
docs/private/**
docs/internal/**
docs/confidential/**
**/*confidential_reviewer*
**/*ethics_reviewer_note_filled*
**/*author_information*
**/*conflict_information*


# ------------------------------------------------------------
# Serialized models / ML checkpoints
# ------------------------------------------------------------
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.ckpt
*.sav
*.model


# ------------------------------------------------------------
# Large scientific / array / tabular artifacts
# ------------------------------------------------------------
*.mat
*.h5
*.hdf5
*.npy
*.npz
*.parquet
*.feather
*.arrow
*.edf
*.asc

# SQLite / local databases
*.db
*.sqlite
*.sqlite3


# ------------------------------------------------------------
# Archives / downloaded bundles
# ------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz


# ------------------------------------------------------------
# Temporary / cache / scratch
# ------------------------------------------------------------
.cache/
cache/
tmp/
temp/
scratch/
.local/
downloads/

*.tmp
*.temp
*.bak
*.orig
*.old
*.partial
*.crdownload


# ------------------------------------------------------------
# Office temporary / lock files
# ------------------------------------------------------------
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx


# ------------------------------------------------------------
# Local release folders
#
# SHA256 manifests themselves may be scientifically useful, so
# SHA256SUMSやmanifest名をグローバルには除外しない。
# ------------------------------------------------------------
release/
releases/
local_release/
local_releases/


# ------------------------------------------------------------
# Keep important project metadata
# ------------------------------------------------------------
!README.md
!PROJECT_STRUCTURE.md
!environment.yml
!requirements.txt
!requirements-*.txt
!.gitignore
